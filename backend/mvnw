#!/bin/sh
# Maven Wrapper script — downloads Maven if not present
# This is a minimal wrapper; a full wrapper is generated by `mvn wrapper:wrapper`

set -e

# Determine the Maven version from the wrapper properties
MAVEN_WRAPPER_PROPERTIES="$(dirname "$0")/.mvn/wrapper/maven-wrapper.properties"
if [ -f "$MAVEN_WRAPPER_PROPERTIES" ]; then
  DISTRIBUTION_URL=$(grep "distributionUrl" "$MAVEN_WRAPPER_PROPERTIES" | cut -d'=' -f2-)
fi

# If mvn is available on PATH, use it directly
if command -v mvn > /dev/null 2>&1; then
  exec mvn "$@"
fi

echo "ERROR: mvn not found on PATH and Maven Wrapper auto-download is not configured."
echo "Please install Maven 3.9+ or run: mvn wrapper:wrapper"
exit 1
